{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryoto",
  "version": "0.2.24",
  "identifier": "to.kryo.mobile",
  "build": {
    "devUrl": "http://localhost:1423",
    "frontendDist": "../../dist-mobile",
    "beforeDevCommand": "pnpm --dir .. dev",
    "beforeBuildCommand": "pnpm --dir .. build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kryoto",
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "devCsp": null,
      "csp": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https://kryo.to https://challenges.cloudflare.com"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
