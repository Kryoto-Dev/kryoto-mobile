{
  "name": "kryoto-mobile",
  "private": true,
  "version": "0.2.21",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.mobile.config.ts",
    "build": "tsc --noEmit && vite build --config vite.mobile.config.ts && node -e \"require('fs').renameSync('dist-mobile/mobile.html','dist-mobile/index.html')\"",
    "android:init": "cd mobile && tauri android init",
    "android:dev": "cd mobile && tauri android dev",
    "android:build": "cd mobile && tauri android build --apk"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-barcode-scanner": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "clsx": "^2.1.1",
    "qrcode": "^1.5.4",
    "lucide-react": "^1.34.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.62.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
